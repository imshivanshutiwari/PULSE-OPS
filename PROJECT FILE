          f"runs:/{run_id}/{artifact_path}", model_name)

    promote_to_staging(model_name: str,
                        version: int) -> ModelVersion
      Runs validation gate before promotion
      client.transition_model_version_stage(
          name=model_name, version=version,
          stage="Staging")

    promote_to_production(model_name: str,
                           version: int,
                           champion_version: int) -> bool
      A/B comparison: challenger vs champion
      If challenger_metric > champion_metric + threshold:
        promote challenger
        archive old champion
      Else: keep champion

    rollback(model_name: str) -> ModelVersion
      Load last Production version before current
      Promote it back to Production
      Archive failed version

    get_production_model(model_name: str) -> mlflow.pyfunc
      mlflow.pyfunc.load_model(
          f"models:/{model_name}/Production")

