class EvidentlyDriftDetector:
  Full Evidently AI drift detection suite.
  4 preset types, all fully implemented.

  methods:
    __init__():
      from evidently.report import Report
      from evidently.metric_preset import (
          DataDriftPreset, ModelPerformancePreset,
          DataQualityPreset, TargetDriftPreset)

    detect_data_drift(reference: pd.DataFrame,
                      current: pd.DataFrame) -> DriftReport
      report = Report(metrics=[DataDriftPreset()])
      report.run(reference_data=reference,
                 current_data=current)
      drift_score = report.as_dict()['metrics'][0]['result']
