class DriftBasedRetrigger:
  Automatic retraining trigger on drift detection.

  Trigger conditions (ANY triggers retraining):
    data_drift_share > drift_config.data_threshold (0.3)
    model_accuracy_drop > drift_config.perf_threshold (0.05)
    target_drift_pvalue < drift_config.target_alpha (0.05)
    data_quality_score < drift_config.quality_threshold (0.9)

  methods:
    should_retrain(drift_suite: FullDriftSuite) -> bool
      Check all 4 conditions
      Log reason if triggered

    compute_urgency(drift_suite) -> str
      CRITICAL: data_drift_share > 0.5
      HIGH: data_drift_share > 0.3
      MEDIUM: performance drop only
      LOW: quality issues only

    schedule_retraining(urgency: str) -> PrefectFlowRun
      CRITICAL → immediate trigger
      HIGH → next hour schedule
      MEDIUM → next day schedule
      LOW → weekly schedule

