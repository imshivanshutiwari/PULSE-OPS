@flow(name="training-flow",
      description="Train and register new model version")
def training_flow(dataset_name: str,
                  model_type: str,
                  run_hpo: bool = True):
  with mlflow.start_run():
    data = load_features_task(dataset_name)
    X_train, X_val, X_test, y_train, y_val, y_test = \
        split_data_task(data)
    if run_hpo:
      best_params = hpo_task(X_train, y_train)
    else:
      best_params = load_default_params_task(model_type)
    model = train_model_task(X_train, y_train, best_params)
    metrics = evaluate_model_task(model, X_val, y_val)
    mlflow.log_metrics(metrics)
    register_model_task(model, model_type)

@flow(name="drift-detection-flow",
      description="Scheduled drift check")
def drift_detection_flow(reference_date: str,
                          current_date: str):
  reference = load_reference_data_task(reference_date)
  current = load_current_data_task(current_date)
  drift_suite = run_evidently_task(reference, current)
  store_drift_report_task(drift_suite)
  if should_retrain_task(drift_suite):
    retraining_flow.submit(triggered_by='drift')

@flow(name="retraining-flow",
      description="Self-healing retraining pipeline")
def retraining_flow(triggered_by: str = 'manual'):
  notify_task(f"Retraining triggered by: {triggered_by}")
  data = fetch_fresh_data_task()
  validate_data_task(data)
  new_version = training_flow(data, run_hpo=True)
  gate_passed = evaluation_gate_task(new_version)
  if gate_passed:
    promote_to_production_task(new_version)
    notify_task("New model promoted to Production")
  else:
    rollback_task()
    notify_task("Gate failed, keeping current model")

@flow(name="deployment-flow")
def deployment_flow(model_version: int):
